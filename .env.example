# ============================================================
# ResearchIQ configuration
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` to GitHub (it is in .gitignore).
# ============================================================

# ---------- API KEYS (fill these in) ----------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: only needed if you switch LLM_PROVIDER to openai
OPENAI_API_KEY=

# ---------- Models ----------
# Check current model IDs at https://ai.google.dev/gemini-api/docs/models
# and change them here if a name has changed.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
VISION_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Reranker: "bge" (local cross-encoder, needs sentence-transformers) or "none"
RERANKER=bge
RERANKER_MODEL=BAAI/bge-reranker-base

# ---------- Retrieval settings ----------
CHUNK_TOKENS=800
CHUNK_OVERLAP=100
DENSE_TOP_K=20
BM25_TOP_K=20
FINAL_TOP_K=8
# If the best reranker score is below this, the system refuses ("not enough evidence").
# Tune both on the eval set (eval/run_eval.py prints the scores it saw).
EVIDENCE_THRESHOLD=0.05
# Used instead when RERANKER=none: cosine similarity of the best dense match.
EVIDENCE_THRESHOLD_DENSE=0.45

# ---------- Mock mode ----------
# MOCK_LLM=1 runs the whole pipeline WITHOUT any API key
# (fake embeddings + canned answers). Useful for testing the plumbing.
MOCK_LLM=0

# ---------- Paths ----------
DATA_DIR=data
INDEX_DIR=index
MAX_UPLOAD_MB=30
